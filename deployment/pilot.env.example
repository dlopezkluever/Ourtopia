# Static PWA build variables. These values are embedded in browser JavaScript.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-project-anon-key

# Smoke-only input. The anon key is public, but do not print it in logs.
PILOT_BASE_URL=https://pilot.example.org

# Supabase Edge Function secrets. Set these in the Supabase project, never the PWA host.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=replace-in-secret-manager
EMAIL_FROM=Ourtopia Pilot <pilot@example.org>
STRIPE_WORKER_JWT=replace-in-secret-manager
STRIPE_TEST_SECRET_KEY=replace-with-test-mode-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-test-mode-webhook-secret
STRIPE_APP_ORIGIN=https://pilot.example.org
